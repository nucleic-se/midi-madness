{
  "compilerOptions": {
    "target": "ES2023",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "erasableSyntaxOnly": true,
    "skipLibCheck": true
  },
  "include": [
    "packages/**/*.ts",
    "tests/**/*.ts"
  ],
  "exclude": [
    "packages/graphics",
    "packages/foundation"
  ]
}
